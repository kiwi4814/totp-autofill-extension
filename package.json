{
  "name": "totp-autofill-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "find src tests -type f \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check",
    "build": "bash scripts/build.sh",
    "build:win": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1"
  }
}
