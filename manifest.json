{
  "manifest_version": 3,
  "name": "Local TOTP Autofill",
  "description": "本地 TOTP 验证码生成器，一键自动填充 2FA，数据仅存本地。",
  "version": "0.1.1",
  "action": {
    "default_title": "Local TOTP Autofill",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}
